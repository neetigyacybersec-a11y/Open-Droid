# Pinned toolchain versions for the android-mcp product.
# Docker and scripts/setup.sh source this same file, so the two install paths
# cannot silently drift. Digests are the upstream-published SHA-256 of the exact
# artifact downloaded below; upstreams without published digests are marked.
JAVA_MAJOR=21
CMDLINE_TOOLS_VERSION=13114758
ANDROID_PLATFORM=android-35
ANDROID_BUILD_TOOLS=35.0.0
GRADLE_VERSION=8.10.2
GRADLE_SHA256=31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26
MAESTRO_VERSION=cli-2.12.1
MAESTRO_SHA256=54dbb0716425626604973cbb374c585ca30272375d9ce15177a1152765ddd9d7
NODE_MAJOR=22
NODE_VERSION=22.18.0
AVD_NAME=Pixel_9_API_35
AVD_DEVICE=pixel_9
# Static analysis (pinned release artifacts; Java is provided by the base image).
JADX_VERSION=1.5.7
JADX_SHA256=1755e4242ade71a077438723689f404079592ec7764a3a0572f98fef94ebcbf3
APKTOOL_VERSION=3.0.3
APKTOOL_SHA256=dbf930b076c6b9be08d57c449cacefc3bdd6b71ebd59b3066fc0e1f5b14f9423
COMPOSE_PREVIEW_VERSION=2.103.1
COMPOSE_PREVIEW_SHA256=36d6ebc3ffbcaf9bee6c270559f38163e436fd7cb86e7d5d2f5f74f3e796a870
# Google publishes the Linux CLI only at a mutable /latest/ URL, with no
# versioned asset or checksum. The smoke test records the installed --version.
ANDROID_CLI_URL=https://dl.google.com/android/cli/latest/linux_x86_64/android
# Dynamic-analysis tooling. FRIDA_TOOLS_VERSION / MITMPROXY_VERSION resolved via
# `pip index versions frida-tools` and `pip index versions mitmproxy` (2026-10-29).
FRIDA_VERSION=17.24.3
FRIDA_TOOLS_VERSION=14.11.0
MITMPROXY_VERSION=12.3.1
FRIDA_SERVER_X86_64_SHA256=44aead87103ab9738771e5eff659640fb6bf566fe83b8629444c1be99f87ce68
FRIDA_SERVER_ARM64_SHA256=a56beefc862e5cc6d02ba9a6203cc98057839c2097a62f8eaba867eb537b6d12
